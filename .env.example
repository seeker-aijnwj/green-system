# json (démo) | postgres | firebase
STORAGE=json
SEED_DEMO=true
PORT=3001

# --- PostgreSQL ---
DATABASE_URL=postgres://greensystem:change-me@localhost:5432/greensystem
PGSSL=false

# --- Firebase / Firestore ---
# Soit le contenu JSON de la clé de service sur une seule ligne, soit GOOGLE_APPLICATION_CREDENTIALS=/chemin/cle.json
FIREBASE_SERVICE_ACCOUNT=

# Clé de signature des sessions (obligatoire en production) : openssl rand -hex 32
SESSION_SECRET=

# ---------- Notifications et rappels (OPTIONNELS : rien n'est envoyé tant que ces lignes ne sont pas renseignées) ----------
# Chaque utilisateur choisit dans son profil s'il veut être prévenu par e-mail et/ou par SMS.
APP_URL=http://localhost:3001
# E-mail : none | log (console, pour tester) | smtp
EMAIL_PROVIDER=none
SMTP_URL=
EMAIL_FROM="Green System <no-reply@example.ci>"
# SMS : none | log | twilio | africastalking | webhook
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Rappels aux coopératives qui n'ont pas répondu : 1er rappel après X heures, puis toutes les Y heures, N fois au plus
REMINDER_AFTER_HOURS=24
REMINDER_REPEAT_HOURS=48
REMINDER_MAX=3
REMINDER_CHECK_MINUTES=15
# Heures calmes (GMT) sans rappel : "20-7" = de 20 h à 7 h ; "off" pour désactiver
QUIET_HOURS=20-7
